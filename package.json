{
  "name": "margin-workspace", "version": "0.2.0", "private": true,
  "workspaces": ["packages/*"], "engines": {"node": ">=22 <23 || >=24 <25"},
  "scripts": {
    "build": "tsc -b && node scripts/bundle.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run build && node --test tests/*.test.cjs",
    "demo": "npm run build && node scripts/demo.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test:extension": "npm run build && node scripts/smoke.mjs",
    "margin": "node packages/cli/dist/main.js",
    "setup": "node scripts/setup.mjs",
    "test:install": "node scripts/install-smoke.mjs"
  },
  "devDependencies": {"@types/node": "22.18.6", "@types/vscode": "1.100.0", "@vscode/test-electron": "3.1.0", "@vscode/vsce": "3.9.2", "esbuild": "0.28.2", "typescript": "5.9.3"}
}
